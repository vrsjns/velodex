# Copy this file to .env and fill in the values

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET_NAME=velo-horoscope-01
# S3 object key for the exported riders list (keep in sync with the
# generator's RIDERS_FILE and the frontend's VITE_RIDERS_LIST_PATH)
RIDERS_FILE=riders.json

# PostgreSQL connection string
DB_URL=postgresql://velostrology:velostrology@localhost:5432/velostrology

# Scraper performance settings
SCRAPER_MAX_CONCURRENT=20
SCRAPER_REQUEST_DELAY=0.1

# JWT / Auth
JWT_SECRET=change-me-to-a-random-string
ADMIN_EMAIL=admin@velodex.com
ADMIN_PASSWORD=change-me

# For local development with LocalStack, use:
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# S3_ENDPOINT_URL=http://localhost:4566
